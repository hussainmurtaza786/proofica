# SafeRent environment configuration

# Database. SQLite is used for local development.
# For PostgreSQL, change to: postgresql://USER:PASSWORD@localhost:5432/saferent
DATABASE_URL="file:./dev.db"

# Auth.js secret - generate with: npx auth secret
AUTH_SECRET="dev-secret-change-me-please-generate-a-random-string"
AUTH_TRUST_HOST=true

# Public app url
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (local disk provider is the default for development)
# For S3-compatible storage later (AWS S3 / Cloudflare R2 / Supabase):
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# STORAGE_ENDPOINT="https://s3.example.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="saferent"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
